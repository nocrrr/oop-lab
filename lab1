using System;

namespace LaboratoryWork1
{
    class Program
    {
        static void Main()
        {
            ExecuteTask1();
            ExecuteTask2();
            ExecuteTask3();

            Console.WriteLine();
            Console.WriteLine("Нажмите Enter для завершения...");
            Console.ReadLine();
        }

        static void ExecuteTask1()
        {
            Console.WriteLine("--- Задача 1 ---");
            
            Console.Write("Введите n: ");
            string inputN = Console.ReadLine()!;
            int n = Convert.ToInt32(inputN);

            Console.Write("Введите m: ");
            string inputM = Console.ReadLine()!;
            int m = Convert.ToInt32(inputM);

            if (n == 1)
            {
                Console.WriteLine("1) m / --n++ = Ошибка: деление на ноль.");
            }
            else
            {
                double result1 = (double)m / (n - 1);
                Console.WriteLine("1) m / --n++ = " + result1 + " (Состояние: n=" + n + ", m=" + m + ")");
            }

            if (n == 0)
            {
                Console.WriteLine("2) Ошибка: деление на ноль в m/n.");
            }
            else
            {
                bool result2 = ((double)m / n) < n;
                int nAfterSecondTask = n - 1;
                Console.WriteLine("2) m / n < n-- является " + result2 + " (Состояние: n=" + nAfterSecondTask + ", m=" + m + ")");
            }

            bool result3 = false;
            int nAfterThirdTask = n + 1;
            Console.WriteLine("3) m + n++ > n + m является " + result3 + " (Состояние: n=" + nAfterThirdTask + ", m=" + m + ")");
        }

        static void ExecuteTask2()
        {
            Console.WriteLine();
            Console.WriteLine("--- Задача 2 ---");

            Console.Write("Введите координату X1: ");
            string inputX = Console.ReadLine()!;
            double x = Convert.ToDouble(inputX);

            Console.Write("Введите координату Y1: ");
            string inputY = Console.ReadLine()!;
            double y = Convert.ToDouble(inputY);

            double distance = x * x + y * y;

            bool topCircle = (y >= 0) && (x <= 0) && (distance <= 1.0);
            bool topTriangle = (y >= 0) && (x >= 0) && (y <= 1.0 - x / 5.0);
            bool bottomCircle = (y <= 0) && (x >= 0) && (distance <= 1.0);
            bool bottomTriangle = (y <= 0) && (x <= 0) && (y >= -1.0 - x / 5.0);

            bool isInside = topCircle || topTriangle || bottomCircle || bottomTriangle;

            if (isInside)
            {
                Console.WriteLine("принадлежит");
            }
            else
            {
                Console.WriteLine("не принадлежит");
            }
        }

        static void ExecuteTask3()
        {
            Console.WriteLine();
            Console.WriteLine("--- Задача 3 ---");

            double a = 1000.0;
            double b = 0.0001;

            double numDouble = (a - b) * (a - b) * (a - b) * (a - b) - (a * a * a * a);
            double denDouble = 6 * a * a * b * b - 4 * a * b * b * b + b * b * b * b - 4 * a * a * a * b;
            double resDouble = numDouble / denDouble;

            float aF = 1000.0f;
            float bF = 0.0001f;
            float numFloat = (aF - bF) * (aF - bF) * (aF - bF) * (aF - bF) - (aF * aF * aF * aF);
            float denFloat = 6 * aF * aF * bF * bF - 4 * aF * bF * bF * bF + bF * bF * bF * bF - 4 * aF * aF * aF * bF;
            float resFloat = numFloat / denFloat;

            Console.WriteLine("Результат с типом данных (double): " + resDouble);
            Console.WriteLine("Результат с типом данных (float): " + resFloat);
        }
    }
}
